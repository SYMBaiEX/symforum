# Next.js and Convex connection
# `bunx convex dev` normally writes these values to .env.local.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SITE_URL=

# OpenAI plugin directory domain verification. Configure only the exact token
# issued by the submission portal; the route fails closed while this is empty.
OPENAI_APPS_CHALLENGE_TOKEN=

# Optional Chrome WebMCP Origin Trial token for the www.symbaiex.com HTML pages
# that register browser tools. Enrollment and token issuance are site-owner actions.
WEBMCP_ORIGIN_TRIAL_TOKEN=

# AI model routing: OpenRouter-only model and embedding routes
OPENROUTER_API_KEY=
OPENROUTER_DAILY_BUDGET_USD=0
# Generate a random 32+ character server-only value; configure the same value in Vercel and Convex.
AI_USAGE_SETTLEMENT_SECRET=
SEMANTIC_SEARCH_ENABLED=false
SEMANTIC_SEARCH_AUTO_INDEX_ENABLED=false
SEMANTIC_SEARCH_DAILY_BUDGET_USD=0.05
SEMANTIC_SEARCH_EMBEDDING_MODEL=openai/text-embedding-3-small
# Generate a random 32+ character value outside model context and configure
# the exact same value in Vercel and Convex before exposing semantic search.
AGENT_SEMANTIC_RELAY_SECRET=
FORUM_AGENT_DAILY_PUBLICATION_LIMIT=42

# Convex Auth
SITE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
JWT_PRIVATE_KEY=
JWKS=
# Server-only random 32-byte hex secret, identical across trusted production apps.
# Enables encrypted sharing of existing Convex Auth sessions; never NEXT_PUBLIC_.
# Leave empty in localhost and preview environments.
AUTH_SHARED_SESSION_SECRET=

# Better Auth cutover: coordinate Convex and all five app builds only after
# provider and account-preservation verification. Leave previews disabled.
BETTER_AUTH_ENABLED=false
NEXT_PUBLIC_BETTER_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
IDENTITY_SITE_URL=https://www.symbaiex.com
# Separate client: do not overwrite the legacy AUTH_GOOGLE_ID/SECRET above.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Public client ID only; never a Telegram bot token in the browser.
TELEGRAM_LOGIN_CLIENT_ID=
AGENT_SELF_JOIN_ENABLED=false
# Purpose-specific server-only secret shared by the app relays and Convex.
AGENT_JOIN_RELAY_SECRET=

# WorkOS Standalone Connect. Existing Convex Auth and agent keys stay unchanged.
# Set the same issuer/enabled flag in Vercel production and Convex production.
# Keep disabled until the dashboard resource, external sign-in URI and client
# registration are configured and the OAuth lifecycle has been verified.
WORKOS_CONNECT_ENABLED=false
WORKOS_AGENT_REGISTRATION_ENABLED=false
WORKOS_AUTHKIT_ISSUER=
# Server-side only; never NEXT_PUBLIC_, client-side code, logs, or source control.
WORKOS_API_KEY=

# WorkOS AuthKit human identity, shared by the five app roots.
# Configure identical WORKOS_CLIENT_ID, WORKOS_COOKIE_PASSWORD and
# WORKOS_COOKIE_DOMAIN on every Vercel app. Set WORKOS_CLIENT_ID in Convex too.
# Enable only after account migration and the callback/logout URIs are configured.
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
# Production trusted sibling hosts only; leave empty for localhost and previews.
WORKOS_COOKIE_DOMAIN=
NEXT_PUBLIC_WORKOS_ENABLED=false
NEXT_PUBLIC_WORKOS_AGENT_REGISTRATION_ENABLED=false
# Set per app to its registered https://<host>/callback URI.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://www.symbaiex.com/callback

# Optional Cloudflare Web Bot Auth directory. Keep the private JWK secret.
# The legacy public JWK is still supported. To overlap a key rotation, use the
# public-only JSON keyset documented in docs/web-bot-auth-key-rotation.md.
WEB_BOT_AUTH_PRIVATE_JWK=
WEB_BOT_AUTH_PUBLIC_JWK=
WEB_BOT_AUTH_PUBLIC_JWK_SET=

# GitHub content integration
GITHUB_TOKEN=
GH_TOKEN=

# Evidence API webhooks (disabled unless both are configured in Convex)
# Comma-separated exact HTTPS DNS hostnames; no wildcards or IP literals.
EVIDENCE_WEBHOOK_ALLOWED_HOSTS=
EVIDENCE_WEBHOOK_SIGNING_SECRET=

# Reserved premium agent API boundary (leave disabled until the complete
# host, entitlement, ledger, and billing-policy activation release is ready).
PREMIUM_AGENT_API_ENABLED=false
PREMIUM_AGENT_API_HOST=

# Resend, newsletter, and contact delivery
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=
NEWSLETTER_SITE_URL=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_TO=

# Forum notifications
FORUM_EMAIL_NOTIFICATIONS_ENABLED=
FORUM_FROM_EMAIL=
FORUM_REPLY_TO=
FORUM_SITE_URL=

# One-time owner setup
OWNER_BOOTSTRAP_TOKEN=
