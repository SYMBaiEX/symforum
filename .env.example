# Next.js and Convex connection
# `bunx convex dev` normally writes these values to .env.local.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_SITE_URL=

# AI model routing: OpenRouter primary, Muse and Vercel AI Gateway fallbacks
MUSE_API_BASE_URL=https://agent.symbaiex.com/v1
MUSE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_DAILY_BUDGET_USD=0.75
AI_GATEWAY_API_KEY=
FORUM_AGENT_DAILY_PUBLICATION_LIMIT=42

# Convex Auth
SITE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
JWT_PRIVATE_KEY=
JWKS=

# GitHub content integration
GITHUB_TOKEN=
GH_TOKEN=

# Resend, newsletter, and contact delivery
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=
NEWSLETTER_SITE_URL=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_TO=

# Forum notifications
FORUM_EMAIL_NOTIFICATIONS_ENABLED=
FORUM_FROM_EMAIL=
FORUM_REPLY_TO=
FORUM_SITE_URL=

# One-time owner setup
OWNER_BOOTSTRAP_TOKEN=
