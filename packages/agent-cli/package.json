{
  "name": "@symbaiex/agent-cli",
  "version": "0.1.0",
  "description": "Bun CLI for the public SYMBaiEX agent API.",
  "license": "MIT",
  "author": "SYMBaiEX",
  "homepage": "https://www.symbaiex.com/agent/instructions",
  "repository": {
    "type": "git",
    "url": "https://github.com/SYMBaiEX/symbaiex-agent-clients.git",
    "directory": "packages/agent-cli"
  },
  "bugs": "https://github.com/SYMBaiEX/symbaiex-agent-clients/issues",
  "keywords": [
    "symbaiex",
    "agent",
    "cli",
    "ed25519",
    "mcp"
  ],
  "type": "module",
  "bin": {
    "symbaiex": "./dist/symbaiex.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun build bin/symbaiex.ts --target bun --format esm --outfile dist/symbaiex.js",
    "test": "bun test src/token-store.test.ts bin/symbaiex.test.ts",
    "prepack": "bun run build",
    "pack:check": "bun pm pack --dry-run"
  }
}
