{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "../..",
    "paths": {
      "@/app/*": ["apps/forum/app/*"],
      "@/*": [
        "./*"
      ],
      "@symbaiex/auth/*": ["packages/auth/src/*"],
      "@symbaiex/forum-plugin-contract": ["packages/forum-plugin-contract/src/index.ts"],
      "@symbaiex/forum-ui": ["packages/forum-ui/src/index.ts"],
      "@symbaiex/forum-ui/*": ["packages/forum-ui/src/*"]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "../../components/**/*.ts",
    "../../components/**/*.tsx",
    "../../convex/_generated/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "../../lib/**/*.test.ts", "../../lib/**/*.test.tsx", "../../components/**/*.test.ts", "../../components/**/*.test.tsx"]
}
