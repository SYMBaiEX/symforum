{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/app/*": ["./app/*"],
      "@/*": ["../../*"],
      "@symbaiex/auth/*": ["../../packages/auth/src/*"],
      "@symbaiex/forum-plugin-contract": ["../../packages/forum-plugin-contract/src/index.ts"],
      "@symbaiex/forum-ui": ["../../packages/forum-ui/src/index.ts"],
      "@symbaiex/forum-ui/*": ["../../packages/forum-ui/src/*"]
    },
    "plugins": [{ "name": "next" }],
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "../../components/**/*.ts",
    "../../components/**/*.tsx",
    "../../lib/**/*.ts",
    "../../lib/**/*.tsx",
    "../../convex/_generated/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["../../node_modules", "node_modules"]
}
