{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/app/*": ["./app/*"],
      "@symbaiex/auth/*": ["../../packages/auth/src/*"],
      "@/components/newsletter-editorial": ["./components/newsletter-editorial.tsx"],
      "@/*": ["../../*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "../../lib/**/*.test.ts", "../../lib/**/*.test.tsx", "../../components/**/*.test.ts", "../../components/**/*.test.tsx"]
}
