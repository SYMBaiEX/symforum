# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-cli/

# next.js
/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
tmp/
.agents/
.claude/
.cursor/
/claudedocs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files contain secrets. Keep the documented template tracked.
.env
.env.*
!.env.example

# vercel
.vercel

# cloudflare workers
**/.wrangler/
**/.dev.vars*

# typescript
*.tsbuildinfo

# Local browser/session artifacts
output/
.playwright-cli/
