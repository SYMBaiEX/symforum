{
  "name": "symbaiex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/agent-sdk",
    "packages/agent-cli",
    "workers/socials"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "env:check": "bun scripts/sync-convex-env.mjs --check",
    "env:push": "bun scripts/sync-convex-env.mjs",
    "env:push:prod": "bun scripts/sync-convex-env.mjs --prod",
    "build": "next build",
    "start": "next start",
    "deps:audit": "bun audit --production",
    "test": "vitest run",
    "test:devtools": "vitest run convex/agentIdentity.test.ts packages/agent-sdk/src/index.test.ts packages/agent-cli/src/token-store.test.ts packages/agent-cli/bin/symbaiex.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --project convex/tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke:agent:public": "bun scripts/smoke-agent-api.mjs --public-only",
    "smoke:agent:auth": "bun scripts/smoke-agent-api.mjs",
    "certify:agent:auth": "bun scripts/certify-agent-auth.mjs",
    "socials:dev": "bun run --cwd workers/socials dev",
    "socials:test": "bun run --cwd workers/socials test",
    "socials:typecheck": "bun run --cwd workers/socials typecheck",
    "socials:deploy": "bun run --cwd workers/socials deploy",
    "verify": "bun run deps:audit && bun run typecheck && bun run typecheck:convex && bun run lint && bun run test && bun run --cwd packages/agent-sdk build && bun run --cwd packages/agent-sdk test && bun run --cwd packages/agent-cli build && bun run --cwd packages/agent-cli test && bun run socials:typecheck && bun run socials:test && bun run --cwd workers/socials deploy:dry && bun run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.41",
    "@ai-sdk/otel": "1.0.85",
    "@ai-sdk/react": "4.0.88",
    "@auth/core": "0.41.3",
    "@convex-dev/agent": "0.7.1",
    "@convex-dev/aggregate": "0.3.0",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "0.2.7",
    "@convex-dev/workflow": "0.4.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.5",
    "@vercel/otel": "^2.1.3",
    "ai": "7.0.85",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.45.0",
    "convex-helpers": "^0.1.123",
    "fast-xml-parser": "5.11.1",
    "katex": "0.18.4",
    "lucide-react": "0.469.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "6.25.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "web-bot-auth": "0.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vercel/config": "0.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "0.0.56",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "postcss-load-config": "6.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "postcss": "8.5.26",
    "ws": "8.21.0"
  }
}
