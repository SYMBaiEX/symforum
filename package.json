{
  "name": "symbaiex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/agent-sdk",
    "packages/agent-cli",
    "workers/socials"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "bun run --cwd apps/platform dev",
    "dev:backend": "convex dev",
    "env:check": "bun scripts/sync-convex-env.mjs --check",
    "env:push": "bun scripts/sync-convex-env.mjs",
    "env:push:prod": "bun scripts/sync-convex-env.mjs --prod",
    "build": "bun run build:platform",
    "start": "bun run --cwd apps/platform start",
    "deps:audit": "bun scripts/audit-dependencies.mjs",
    "test": "vitest run",
    "test:devtools": "vitest run convex/agentIdentity.test.ts packages/agent-sdk/src/index.test.ts packages/agent-cli/src/token-store.test.ts packages/agent-cli/bin/symbaiex.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --project convex/tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke:agent:public": "bun scripts/smoke-agent-api.mjs --public-only",
    "smoke:forum:public": "bun scripts/smoke-forum-plugin.mjs",
    "smoke:agent:auth": "bun scripts/smoke-agent-api.mjs",
    "certify:agent:auth": "bun scripts/certify-agent-auth.mjs",
    "socials:dev": "bun run --cwd workers/socials dev",
    "socials:test": "bun run --cwd workers/socials test",
    "socials:typecheck": "bun run --cwd workers/socials typecheck",
    "socials:deploy": "bun run --cwd workers/socials deploy",
    "eliza:test": "bun run --cwd workers/eliza-shadow test && bun run --cwd workers/eliza-shadow-gateway test",
    "eliza:check": "bun run --cwd workers/eliza-shadow build && bun run --cwd workers/eliza-shadow-gateway typecheck",
    "verify": "bun run ui:check && bun run deps:audit && bun run typecheck && bun run typecheck:convex && bun run lint && bun run test && bun run --cwd packages/agent-sdk build && bun run --cwd packages/agent-sdk test && bun run --cwd packages/agent-cli build && bun run --cwd packages/agent-cli test && bun run socials:typecheck && bun run socials:test && bun run --cwd workers/socials deploy:dry && bun run build:apps",
    "ui:sync": "bun scripts/sync-forum-ui.mjs && bun scripts/build-native-forum-app.mjs",
    "ui:check": "bun scripts/sync-forum-ui.mjs --check && bun scripts/build-native-forum-app.mjs --check",
    "ui:watch": "bun scripts/watch-forum-ui.mjs",
    "dev:next": "bun run --cwd apps/platform dev",
    "eval:forum:content": "bun scripts/eval-forum-content.ts",
    "build:platform": "bun run --cwd apps/platform build",
    "build:forum": "bun run --cwd apps/forum build",
    "build:blog": "bun run --cwd apps/blog build",
    "build:news": "bun run --cwd apps/news build",
    "build:newsletter": "bun run --cwd apps/newsletter build",
    "build:apps": "bun run build:platform && bun run build:forum && bun run build:blog && bun run build:news && bun run build:newsletter",
    "test:forum:render": "playwright test --config playwright.forum.config.ts",
    "security:secrets": "gitleaks git --redact --no-banner --log-opts=\"--all --full-history\" ."
  },
  "dependencies": {
    "@symbaiex/auth": "workspace:*",
    "@convex-dev/better-auth": "0.12.6",
    "better-auth": "1.7.14",
    "@solana/wallet-standard-util": "1.2.0",
    "@wallet-standard/app": "1.1.1",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@ai-sdk/otel": "1.0.111",
    "@ai-sdk/react": "4.0.114",
    "@auth/core": "0.41.3",
    "@convex-dev/agent": "0.7.3",
    "@convex-dev/aggregate": "0.3.1",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rag": "^0.7.6",
    "@convex-dev/rate-limiter": "0.4.0",
    "@convex-dev/resend": "0.2.8",
    "@convex-dev/workflow": "0.4.8",
    "@convex-dev/workos": "0.0.3",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@openai/mcp-extensions": "0.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.9.9",
    "@vercel/otel": "^2.1.3",
    "@workos-inc/authkit-nextjs": "4.4.0",
    "@workos-inc/node": "10.13.0",
    "ai": "7.0.111",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "convex-helpers": "^0.1.124",
    "fast-xml-parser": "5.11.1",
    "hyparquet": "1.30.0",
    "hyparquet-writer": "0.16.9",
    "jose": "6.2.10",
    "katex": "0.18.7",
    "lightweight-charts": "5.2.1",
    "lucide-react": "0.469.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.3.1",
    "react-email": "6.9.5",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "resend": "6.27.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "web-bot-auth": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "0.7.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "0.0.59",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "postcss-load-config": "6.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@react-email/render": "2.2.0",
    "qs": "6.17.1",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.5",
    "@vercel/config": {
      "zod": "4.6.7"
    },
    "katex": "0.18.7",
    "path-to-regexp": "6.3.0",
    "postcss": "8.5.26",
    "postcss-selector-parser@^6": "6.1.5",
    "sharp": "0.35.5",
    "shell-quote": "1.11.0",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "vite": "8.3.3",
    "ws": "8.21.0",
    "zod@>=4 <5": "4.6.7"
  },
  "patchedDependencies": {
    "@convex-dev/better-auth@0.12.6": "patches/@convex-dev%2Fbetter-auth@0.12.6.patch"
  }
}
