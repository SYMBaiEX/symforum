{
  "name": "symbaiex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/agent-sdk",
    "packages/agent-cli",
    "workers/socials"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev --turbopack",
    "dev:backend": "convex dev",
    "env:check": "bun scripts/sync-convex-env.mjs --check",
    "env:push": "bun scripts/sync-convex-env.mjs",
    "env:push:prod": "bun scripts/sync-convex-env.mjs --prod",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:devtools": "vitest run convex/agentIdentity.test.ts packages/agent-sdk/src/index.test.ts packages/agent-cli/src/token-store.test.ts packages/agent-cli/bin/symbaiex.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc --project convex/tsconfig.json --noEmit",
    "lint": "eslint .",
    "smoke:agent:public": "bun scripts/smoke-agent-api.mjs --public-only",
    "smoke:agent:auth": "bun scripts/smoke-agent-api.mjs",
    "certify:agent:auth": "bun scripts/certify-agent-auth.mjs",
    "socials:dev": "bun run --cwd workers/socials dev",
    "socials:test": "bun run --cwd workers/socials test",
    "socials:typecheck": "bun run --cwd workers/socials typecheck",
    "socials:deploy": "bun run --cwd workers/socials deploy"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.29",
    "@ai-sdk/openai-compatible-v3": "npm:@ai-sdk/openai-compatible@^2.0.0",
    "@ai-sdk/react": "^4.0.1",
    "@auth/core": "^0.37.0",
    "@convex-dev/agent": "^0.6.4",
    "@convex-dev/aggregate": "0.2.2",
    "@convex-dev/auth": "^0.0.77",
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/rag": "^0.7.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@convex-dev/workflow": "^0.4.4",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "@vercel/otel": "^2.1.3",
    "ai": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.17.4",
    "convex-helpers": "^0.1.120",
    "fast-xml-parser": "^5.10.1",
    "framer-motion": "^12.40.0",
    "katex": "^0.17.0",
    "lucide-react": "^0.469.0",
    "next": "16.3.0",
    "next-themes": "^0.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "^6.6.4",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "resend": "^6.14.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "web-bot-auth": "0.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^3.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vercel/config": "^0.5.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "convex-test": "^0.0.54",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8",
    "prettier": "3.4.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "convex": {
      "ws": "8.21.0"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "next": {
      "postcss": "8.5.10"
    }
  }
}
